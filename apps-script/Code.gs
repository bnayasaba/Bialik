/**
 * Google Sheets connector for the Bialik attendance site.
 * Paste into Extensions > Apps Script in the attendance spreadsheet.
 * Deploy as Web App, execute as Me, access Anyone.
 * The /exec URL must only be stored in Vercel as APPS_SCRIPT_URL.
 */
var BOOK_ID='1Y76RFQG5CtiQRQykAmdlQKQiW5UT0wHKs02tlUQJnlk';
function sheet_(name){var s=SpreadsheetApp.openById(BOOK_ID).getSheetByName(name);if(!s)throw Error('לשונית חסרה: '+name);return s}
function rows_(name){return sheet_(name).getDataRange().getValues().slice(1)}
function reply_(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}
function active_(v){return String(v).trim()==='כן'}
function student_(id,ss){var x=ss.filter(function(r){return String(r[0])===id&&active_(r[3])});if(x.length!==1)throw Error('סטודנט לא פעיל');return x[0]}
function doGet(e){try{var q=e.parameter||{},action=q.action||'bootstrap';if(action==='bootstrap'){return reply_({ok:true,students:rows_('סטודנטים').filter(function(r){return r[0]&&active_(r[3])}).map(function(r){return {id:String(r[0]),name:String(r[1]),group:String(r[2])}}),sessions:rows_('מפגשים').filter(function(r){return r[0]}).map(function(r){return {id:String(r[0]),group:String(r[1]),date:String(r[2]),title:String(r[3]),hours:Number(r[4])||7,active:active_(r[5])}})})}if(action==='mine'){var id=String(q.studentId||'');if(!/^s\d{3,6}$/.test(id))throw Error('מזהה לא תקין');student_(id,rows_('סטודנטים'));var reports={};rows_('דיווחים').forEach(function(r){if(String(r[1])===id&&r[2])reports[String(r[2])]=String(r[3]||'')});return reply_({ok:true,reports:reports})}throw Error('פעולה שגויה')}catch(err){return reply_({ok:false,error:String(err.message||err)})}}
function doPost(e){var lock=LockService.getScriptLock();try{var p=JSON.parse((e.postData||{}).contents||'{}');var id=String(p.studentId||'');if(!/^s\d{3,6}$/.test(id))throw Error('מזהה שגוי');lock.waitLock(15000);var studentSheet=sheet_('סטודנטים'),ss=rows_('סטודנטים'),st=student_(id,ss),row=ss.findIndex(function(r){return String(r[0])===id})+2;if(p.action==='chooseGroup'){var g=String(p.group||'');if(['שלישי','רביעי'].indexOf(g)<0)throw Error('קבוצה לא תקינה');if(st[2]!=='טרם שויך'&&String(st[2])!==g)throw Error('לשינוי קבוצה פנו לרכז');studentSheet.getRange(row,3).setValue(g);return reply_({ok:true,group:g})}if(p.action==='report'){var sessionId=String(p.sessionId||''),status=String(p.status==null?'':p.status);if(['','נכחתי','לא נכחתי','מילואים'].indexOf(status)<0)throw Error('סטטוס שגוי');var matches=rows_('מפגשים').filter(function(r){return String(r[0])===sessionId&&active_(r[5])});if(matches.length!==1)throw Error('מפגש אינו פעיל');var session=matches[0];if(['שלישי','רביעי'].indexOf(String(st[2]))<0||(session[1]!==st[2]&&session[1]!=='שתי הקבוצות'))throw Error('המפגש אינו שייך לקבוצה');var sh=sheet_('דיווחים'),rr=rows_('דיווחים'),key=id+'|'+sessionId,old=rr.findIndex(function(r){return String(r[0])===key}),hours=status==='נכחתי'?(Number(session[4])||7):0;if(old>=0){sh.getRange(old+2,4,1,4).setValues([[status,hours,new Date(),'אתר']])}else if(status){sh.appendRow([key,id,sessionId,status,hours,new Date(),'אתר'])}return reply_({ok:true,status:status,hours:hours})}throw Error('פעולה לא נתמכת')}catch(err){return reply_({ok:false,error:String(err.message||err)})}finally{if(lock.hasLock())lock.releaseLock()}}